                        "productName": "프리미엄 멤버십",
                        "quantity": 1,
                        "unitPrice": 29000,
                        "discountAmount": 0
                    },
                    {
                        "productId": "PROD_002",
                        "productName": "추가 저장공간 100GB",
                        "quantity": 2,
                        "unitPrice": 5000,
                        "discountAmount": 1000
                    }
                ]
            },
            {
                "name": "payment",
                "type": "object",
                "required": true,
                "description": "결제 정보",
                "children": [
                    {
                        "name": "method",
                        "type": "String",
                        "required": true,
                        "description": "결제 수단",
                        "enum": [
                            {"code": "CARD", "label": "신용카드"},
                            {"code": "BANK", "label": "계좌이체"},
                            {"code": "PHONE", "label": "휴대폰결제"},
                            {"code": "POINT", "label": "포인트"}
                        ],
                        "defaultValue": "CARD"
                    },
                    {
                        "name": "totalAmount",
                        "type": "Number",
                        "required": true,
                        "description": "총 결제 금액",
                        "defaultValue": "38000"
