            },
            {
                "name": "customer",
                "type": "object",
                "required": false,
                "description": "고객 정보",
                "children": [
                    {
                        "name": "customerId",
                        "type": "String",
                        "required": true,
                        "description": "고객 ID",
                        "maxLength": 50,
                        "defaultValue": "CUST_001"
                    },
                    {
                        "name": "customerName",
                        "type": "String",
                        "required": false,
                        "description": "고객명",
